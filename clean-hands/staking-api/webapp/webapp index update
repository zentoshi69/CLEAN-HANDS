      $('mMc').textContent = PRICE.market_cap ? '$' + fmt(PRICE.market_cap) : '—';
      $('mLiq').textContent = PRICE.liquidity_usd ? '$' + fmt(PRICE.liquidity_usd) : '—';
      $('mVol').textContent = PRICE.volume_24h ? '$' + fmt(PRICE.volume_24h) : '—';
      updatePortfolio();
    } catch (e) {}

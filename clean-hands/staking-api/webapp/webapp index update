<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"/>
<title>$CLEAN — Soft Staking</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="/nacl.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  --sky:#86BFF8;--sky-2:#A9D3FB;--sky-soft:#D6EAFD;--glove:#EAF4FE;
  --paper:#F4FAFF;--white:#fff;--ink:#1B5DA6;--ink-2:#2E74C0;--ink-deep:#0F3E73;
  --text:#16385c;--muted:#5d7ea3;--line:rgba(27,93,166,.16);--line-2:rgba(27,93,166,.28);
  --pos:#2f9e63;--fire:#ff7a3c;
  --shadow:0 22px 50px -28px rgba(27,93,166,.45);--shadow-sm:0 10px 26px -16px rgba(27,93,166,.45);
  --ease:cubic-bezier(.2,.7,.2,1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--paper);color:var(--text);-webkit-font-smoothing:antialiased;overflow:hidden}
.app{position:relative;max-width:480px;margin:0 auto;height:100dvh;display:flex;flex-direction:column;overflow:hidden;background:var(--paper)}

/* ambient aura — slow drifting glow orbs */
.aura{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.aura b{position:absolute;border-radius:50%;filter:blur(46px);opacity:.6;will-change:transform}
.aura .a1{width:300px;height:300px;top:-90px;left:-60px;background:radial-gradient(closest-side,#A9D3FB,transparent);animation:drift1 16s ease-in-out infinite}
.aura .a2{width:280px;height:280px;bottom:40px;right:-80px;background:radial-gradient(closest-side,#D6EAFD,transparent);animation:drift2 19s ease-in-out infinite}
.aura .a3{width:220px;height:220px;top:38%;left:40%;background:radial-gradient(closest-side,#BFE0FF,transparent);opacity:.4;animation:drift3 22s ease-in-out infinite}
@keyframes drift1{0%,100%{transform:translate(0,0)}50%{transform:translate(30px,40px)}}
@keyframes drift2{0%,100%{transform:translate(0,0)}50%{transform:translate(-34px,-30px)}}
@keyframes drift3{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(20px,-26px) scale(1.1)}}

.spark{position:absolute;z-index:1;color:#fff;font-family:'Fraunces',serif;pointer-events:none;filter:drop-shadow(0 2px 7px rgba(46,116,192,.55));animation:tw 3.6s ease-in-out infinite}
@keyframes tw{0%,100%{opacity:.12;transform:scale(.6)}50%{opacity:.95;transform:scale(1.12)}}

/* header */
.top{position:relative;z-index:5;flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px 16px 12px;
  background:rgba(255,255,255,.6);backdrop-filter:blur(16px);border-bottom:1.5px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px}
.brand .av{width:38px;height:38px;border-radius:50%;border:1.5px solid var(--line);background:#fff;position:relative;overflow:hidden}
.brand .av img{width:100%;display:block}
.brand .av::after{content:"";position:absolute;top:-60%;left:-70%;width:55%;height:220%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.7),transparent);transform:rotate(8deg);animation:sweep 5.5s ease-in-out infinite}
@keyframes sweep{0%{left:-70%}55%,100%{left:170%}}
.brand b{font-family:'Fraunces',serif;font-size:1.15rem;color:var(--ink-deep);letter-spacing:.02em;display:block;line-height:1}
.brand small{font-size:.72rem;color:var(--muted);font-weight:600}
.wallet{font-family:inherit;font-size:.78rem;font-weight:700;color:var(--ink-2);background:rgba(255,255,255,.7);border:1.5px solid var(--line-2);border-radius:100px;padding:8px 14px;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:7px}
.wallet:active{transform:scale(.96)}
.wallet .dot{width:7px;height:7px;border-radius:50%;background:var(--muted)}
.wallet.live .dot{background:#3fc77e;box-shadow:0 0 0 4px rgba(63,199,126,.18)}

/* scroll */
.scroll{position:relative;z-index:2;flex:1 1 auto;overflow-y:auto;padding:16px 16px 100px;-webkit-overflow-scrolling:touch}
.tab[hidden]{display:none}
.tab>*{opacity:0;transform:translateY(14px);animation:rise .55s var(--ease) forwards}
.tab>*:nth-child(2){animation-delay:.06s}.tab>*:nth-child(3){animation-delay:.12s}.tab>*:nth-child(4){animation-delay:.18s}.tab>*:nth-child(5){animation-delay:.24s}
@keyframes rise{to{opacity:1;transform:none}}

.card{position:relative;background:rgba(255,255,255,.66);backdrop-filter:blur(8px);border:1.5px solid var(--line);border-radius:22px;box-shadow:var(--shadow-sm)}

/* APR hero with breathing gradient glow ring + shine number */
.apr{text-align:center;padding:32px 20px;margin-bottom:14px;overflow:hidden}
.apr::before{content:"";position:absolute;inset:-2px;border-radius:24px;padding:2px;z-index:0;
  background:linear-gradient(120deg,var(--sky),#fff,var(--sky-2),var(--ink-2),var(--sky));background-size:300% 300%;
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;
  opacity:.55;animation:ringflow 8s ease infinite}
@keyframes ringflow{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
.apr .halo{position:absolute;inset:-30% 18% auto;height:170px;z-index:0;background:radial-gradient(closest-side,rgba(134,191,248,.55),transparent 70%);filter:blur(20px);animation:breathe 4s ease-in-out infinite}
@keyframes breathe{0%,100%{opacity:.5;transform:scale(.96)}50%{opacity:.85;transform:scale(1.05)}}
.apr .num{position:relative;z-index:1;font-family:'Fraunces',serif;font-weight:700;font-size:clamp(3rem,17vw,4.6rem);line-height:1;
  background:linear-gradient(110deg,var(--ink-deep) 0 42%,#bfe0ff 49%,#fff 50%,#bfe0ff 51%,var(--ink-deep) 60% 100%);
  background-size:240% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;animation:shine 5s ease-in-out infinite}
@keyframes shine{0%{background-position:150% 0}55%,100%{background-position:-50% 0}}
.apr .lbl{position:relative;z-index:1;font-size:.72rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-2);margin-top:6px}

.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.stat{padding:16px 8px;text-align:center}
.stat .k{font-family:'Fraunces',serif;font-weight:700;font-size:1.3rem;color:var(--ink-deep);font-variant-numeric:tabular-nums}
.stat .l{font-size:.66rem;color:var(--muted);font-weight:600;margin-top:2px;letter-spacing:.04em}

.panel{padding:18px;margin-bottom:14px}
.panel h3{font-family:'Fraunces',serif;font-weight:600;font-size:1.1rem;color:var(--ink-deep);margin-bottom:6px;display:flex;align-items:center;gap:8px}
.panel .desc{font-size:.86rem;color:var(--muted);margin-bottom:14px;line-height:1.5}
.panel .desc b{color:var(--ink-deep)}

.row{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px dashed var(--line);font-size:.95rem}
.row:last-child{border-bottom:none}
.row .v{font-weight:700;color:var(--pos);font-variant-numeric:tabular-nums;transition:color .3s}
.row .v.zero{color:var(--muted)}
.row .v.ink{color:var(--ink-deep)}
.row .name{color:var(--text);display:flex;align-items:center;gap:8px}

.btn{position:relative;width:100%;border:none;border-radius:14px;padding:15px;font-family:inherit;font-weight:700;font-size:1rem;cursor:pointer;transition:transform .15s,box-shadow .2s,background .2s;letter-spacing:.01em;overflow:hidden}
.btn:active{transform:scale(.985)}
.btn-solid{background:var(--ink-2);color:#fff;box-shadow:0 12px 24px -12px rgba(46,116,192,.8)}
.btn-solid:active{background:var(--ink)}
.btn-ghost{background:rgba(255,255,255,.6);border:1.5px solid var(--line-2);color:var(--ink-2)}
.btn-shine{background:linear-gradient(120deg,var(--sky),var(--ink-2));color:#fff;box-shadow:0 14px 28px -12px rgba(46,116,192,.85)}
.btn-shine::after{content:"";position:absolute;top:0;left:-60%;width:45%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.5),transparent);transform:skewX(-18deg);animation:btnsweep 3.4s ease-in-out infinite}
@keyframes btnsweep{0%{left:-60%}45%,100%{left:160%}}
.btn-fire{background:linear-gradient(120deg,var(--fire),#e05a1f);color:#fff;box-shadow:0 14px 28px -12px rgba(224,90,31,.7)}
.btn-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.btn:disabled{opacity:.7;cursor:default}
.btn .spin{display:inline-block;width:16px;height:16px;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:rot .7s linear infinite;vertical-align:-3px}
@keyframes rot{to{transform:rotate(360deg)}}

.field{margin:12px 0}
.field .top-l{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);font-weight:600;margin-bottom:7px}
.input{display:flex;align-items:center;background:#fff;border:1.5px solid var(--line);border-radius:13px;padding:13px 14px}
.input input{flex:1;border:none;outline:none;font-family:inherit;font-size:.95rem;font-weight:600;color:var(--ink-deep);background:none;min-width:0}

.gauge{height:10px;border-radius:100px;background:var(--glove);overflow:hidden;border:1.5px solid var(--line);margin:12px 0;position:relative}
.gauge i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--sky),var(--ink-2));border-radius:100px;transition:width .6s var(--ease);box-shadow:0 0 12px rgba(46,116,192,.5)}
.chips{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}
.chip{position:relative;border:1.5px solid var(--line-2);background:#fff;border-radius:12px;padding:11px 4px;font-weight:700;font-size:.82rem;color:var(--ink-deep);cursor:pointer;transition:.18s;font-family:inherit}
.chip:active{transform:scale(.94)}
.chip:hover{border-color:var(--fire);color:var(--fire);box-shadow:0 8px 18px -10px rgba(255,122,60,.7)}

.spark-burst{position:fixed;pointer-events:none;z-index:30;font-family:'Fraunces',serif;color:var(--sky);will-change:transform,opacity}

.lb{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px dashed var(--line)}
.lb:last-child{border:none}
.lb.you{margin:4px -10px;padding:12px 10px;background:var(--glove);border-radius:14px;border:1.5px solid var(--line-2);box-shadow:0 0 18px rgba(134,191,248,.4)}
.lb .rk{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:.8rem;background:var(--glove);color:var(--ink-2);border:1.5px solid var(--line);flex:0 0 auto}
.lb .rk.g{background:linear-gradient(135deg,#ffd87a,#ffb24d);color:#7a4a00;border-color:#ffcf6e}
.lb .rk.s{background:linear-gradient(135deg,#e7eef6,#c6d6e8);color:#3a587a;border:none}
.lb .rk.b{background:linear-gradient(135deg,#f3c39a,#d99a63);color:#5a2f12;border:none}
.lb .ad{font-family:ui-monospace,Menlo,monospace;font-size:.88rem;color:var(--ink-deep);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lb .amt{margin-left:auto;font-weight:700;color:var(--ink-deep);font-size:.9rem;font-variant-numeric:tabular-nums}

.ca{display:flex;align-items:center;gap:10px;border:1.5px solid var(--line-2);background:#fff;border-radius:13px;padding:10px 10px 10px 14px;margin:6px 0 14px;cursor:pointer}
.ca .lab{font-size:.62rem;font-weight:800;letter-spacing:.18em;color:var(--ink-2)}
.ca code{font-family:ui-monospace,Menlo,monospace;font-size:.8rem;color:var(--ink-deep);font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ca .cp{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#fff;background:var(--ink-2);border-radius:100px;padding:6px 11px;flex:0 0 auto}

.spark-line{width:100%;height:56px;margin:6px 0 14px}
.spark-line path.area{fill:url(#g1);opacity:.25}
.spark-line path.ln{fill:none;stroke:var(--ink-2);stroke-width:2.5;stroke-linecap:round;stroke-dasharray:600;stroke-dashoffset:600;animation:draw 1.6s var(--ease) forwards}
@keyframes draw{to{stroke-dashoffset:0}}

.scr{font-family:'Caveat',cursive;color:var(--ink-2)}
.muted{color:var(--muted);font-size:.86rem;line-height:1.5}
.empty{text-align:center;color:var(--muted);font-size:.9rem;padding:18px 6px}
.act{display:flex;align-items:center;gap:11px;padding:10px 0;border-bottom:1px dashed var(--line);font-size:.88rem}
.act:last-child{border:none}
.act .ic{width:30px;height:30px;border-radius:50%;background:var(--glove);border:1.5px solid var(--line);display:grid;place-items:center;flex:0 0 auto}
.act .tm{margin-left:auto;color:var(--muted);font-size:.74rem}
.hide{display:none!important}

.live-note{color:var(--pos);font-size:.8rem;font-weight:600;margin-top:10px;text-align:center}
.live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--pos);vertical-align:middle;margin-right:6px;
  box-shadow:0 0 0 0 rgba(47,158,99,.6);animation:pulse 1.8s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(47,158,99,.55)}70%{box-shadow:0 0 0 7px rgba(47,158,99,0)}100%{box-shadow:0 0 0 0 rgba(47,158,99,0)}}

/* tab bar with sliding glow */
.tabbar{position:absolute;left:0;right:0;bottom:0;z-index:6;display:flex;justify-content:space-around;
  padding:10px 6px calc(10px + env(safe-area-inset-bottom));background:rgba(255,255,255,.84);backdrop-filter:blur(18px);border-top:1.5px solid var(--line)}
.tabind{position:absolute;top:6px;left:0;width:20%;height:42px;border-radius:16px;pointer-events:none;z-index:0;
  background:radial-gradient(closest-side,rgba(134,191,248,.55),transparent 75%);transform:translateX(calc(var(--i,0)*100%));transition:transform .38s var(--ease)}
.tabbtn{position:relative;z-index:1;flex:1;background:none;border:none;display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--muted);font-family:inherit;font-weight:700;font-size:.66rem;letter-spacing:.02em;cursor:pointer;padding:4px 0;transition:color .25s}
.tabbtn svg{width:23px;height:23px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .25s}
.tabbtn.on{color:var(--ink-2)}
.tabbtn.on svg{transform:translateY(-1px) scale(1.08)}

#toast{position:fixed;left:50%;bottom:88px;transform:translateX(-50%) translateY(20px);background:var(--ink-deep);color:#fff;
  padding:11px 18px;border-radius:100px;font-size:.86rem;font-weight:600;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:.35s var(--ease);z-index:40;max-width:90%;text-align:center}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* splash */
#splash{position:fixed;inset:0;z-index:90;display:grid;place-items:center;background:
  radial-gradient(60% 40% at 50% 30%,#fff,transparent),var(--paper);transition:opacity .6s ease,visibility .6s}
#splash.hide{opacity:0;visibility:hidden}
.sp-logo{width:128px;height:128px;border-radius:50%;position:relative;margin:0 auto 22px;animation:pop .8s var(--ease) both}
@keyframes pop{0%{transform:scale(.7);opacity:0}100%{transform:scale(1);opacity:1}}
.sp-logo .gl{position:absolute;inset:-18px;border-radius:50%;background:radial-gradient(closest-side,#CDE6FF,transparent 72%);filter:blur(13px);animation:breathe 3.4s ease-in-out infinite}
.sp-logo .rg{position:absolute;inset:0;border-radius:50%;overflow:hidden;border:2px solid #fff;box-shadow:var(--shadow);background:#fff}
.sp-logo .rg img{width:100%;display:block}
.sp-logo .rg::after{content:"";position:absolute;top:-60%;left:-70%;width:55%;height:220%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.75),transparent);transform:rotate(8deg);animation:sweep 2.6s ease-in-out infinite}
.sp-name{font-family:'Fraunces',serif;font-weight:700;font-size:2rem;color:var(--ink-deep);text-align:center;letter-spacing:.02em}
.sp-sub{font-family:'Caveat',cursive;font-size:1.3rem;color:var(--ink-2);text-align:center;margin-top:-2px}
.sp-bar{width:140px;height:5px;border-radius:100px;background:var(--glove);overflow:hidden;margin:22px auto 0;border:1px solid var(--line)}
.sp-bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--sky),var(--ink-2));border-radius:100px;animation:load 1.3s var(--ease) forwards}
@keyframes load{to{width:100%}}

/* welcome / connect gate */
#welcome{position:fixed;inset:0;z-index:80;display:flex;flex-direction:column;justify-content:center;padding:30px 26px calc(30px + env(safe-area-inset-bottom));
  background:radial-gradient(60% 40% at 50% 10%,#fff,transparent),var(--paper);transition:transform .55s var(--ease),opacity .5s;max-width:480px;margin:0 auto}
#welcome.hide{transform:translateY(-30px);opacity:0;visibility:hidden;pointer-events:none}
.wc-logo{width:104px;height:104px;border-radius:50%;position:relative;margin:0 auto 22px}
.wc-logo .gl{position:absolute;inset:-16px;border-radius:50%;background:radial-gradient(closest-side,#CDE6FF,transparent 72%);filter:blur(13px);animation:breathe 3.6s ease-in-out infinite}
.wc-logo .rg{position:absolute;inset:0;border-radius:50%;overflow:hidden;border:2px solid #fff;box-shadow:var(--shadow);background:#fff}
.wc-logo .rg img{width:100%;display:block}
.wc h1{font-family:'Fraunces',serif;font-weight:600;font-size:2.1rem;color:var(--ink-deep);text-align:center;line-height:1.05;letter-spacing:-.01em}
.wc h1 .scr{display:block;font-family:'Caveat',cursive;color:var(--ink-2);font-size:1.7rem}
.wc .feats{margin:24px 0;display:flex;flex-direction:column;gap:12px}
.feat{display:flex;align-items:center;gap:13px;background:rgba(255,255,255,.6);border:1.5px solid var(--line);border-radius:16px;padding:13px 15px}
.feat .ic{width:38px;height:38px;border-radius:11px;background:var(--glove);border:1.5px solid var(--line);display:grid;place-items:center;font-size:1.1rem;flex:0 0 auto}
.feat b{display:block;color:var(--ink-deep);font-size:.95rem;font-family:'Fraunces',serif;font-weight:600}
.feat span{font-size:.8rem;color:var(--muted)}
.wc .explore{display:block;text-align:center;margin-top:14px;color:var(--ink-2);font-weight:700;font-size:.86rem;background:none;border:none;width:100%;cursor:pointer;font-family:inherit}

/* wallet picker sheet */
.sheet-bg{position:fixed;inset:0;background:rgba(15,62,115,.35);backdrop-filter:blur(3px);z-index:85;opacity:0;pointer-events:none;transition:.25s}
.sheet-bg.show{opacity:1;pointer-events:auto}
.sheet{position:fixed;left:0;right:0;bottom:0;max-width:480px;margin:0 auto;background:var(--paper);border-radius:24px 24px 0 0;
  border:1.5px solid var(--line);border-bottom:none;box-shadow:var(--shadow);padding:20px 18px calc(20px + env(safe-area-inset-bottom));
  z-index:86;transform:translateY(105%);transition:.3s var(--ease)}
.sheet.show{transform:none}
.sheet h3{font-family:'Fraunces',serif;font-weight:600;font-size:1.1rem;color:var(--ink-deep);margin-bottom:4px}
.sheet p{font-size:.84rem;color:var(--muted);margin-bottom:14px}
.sheet .btn{margin-bottom:9px}
.sheet .spin2{width:22px;height:22px;border:3px solid var(--sky-soft);border-top-color:var(--ink-2);border-radius:50%;animation:rot .8s linear infinite;margin:8px auto 0}

@media(prefers-reduced-motion:reduce){*{animation:none!important;transition-duration:.01ms!important}
  .tab>*{opacity:1;transform:none}.apr .num{-webkit-text-fill-color:var(--ink-deep);color:var(--ink-deep)}}
</style>
</head>
<body>

<!-- SPLASH (first window) -->
<div id="splash">
  <div>
    <div class="sp-logo"><div class="gl"></div><div class="rg"><img src="/glove.png" alt="CLEAN"></div></div>
    <div class="sp-name">$CLEAN</div>
    <div class="sp-sub">soft staking</div>
    <div class="sp-bar"><i></i></div>
  </div>
</div>

<!-- WELCOME / CONNECT -->
<div id="welcome" class="hide">
  <div class="wc-logo"><div class="gl"></div><div class="rg"><img src="/glove.png" alt=""></div></div>
  <div class="wc">
    <h1>Wash your bags.<span class="scr">gloves on ✦</span></h1>
    <div class="feats">
      <div class="feat"><div class="ic">🧤</div><div><b>Soft staking</b><span>Earn without locking — tokens stay in your wallet.</span></div></div>
      <div class="feat"><div class="ic">🔥</div><div><b>Burn to boost</b><span id="featBurn">Burn $CLEAN to permanently lift your APR.</span></div></div>
      <div class="feat"><div class="ic">✦</div><div><b>Invite to earn</b><span>Every friend who stakes adds to your rate.</span></div></div>
    </div>
    <button class="btn btn-shine" id="wcConnect">Connect wallet</button>
    <button class="explore" id="wcExplore">Explore first →</button>
  <a class="btn btn-ghost" href="/whitepaper" style="display:block;text-align:center;text-decoration:none">📄 White Paper</a>
  </div>

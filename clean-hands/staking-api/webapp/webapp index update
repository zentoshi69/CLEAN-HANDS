    if (!PRICE || !PRICE.available || !PROFILE) return;
    $('mPortfolio').textContent =
      `Your stake ${usd(PROFILE.staked)} · pending ${usd(PROFILE.pending_rewards)} · wallet ${usd(PROFILE.balance)}`;

<script>
const $=s=>document.querySelector(s);
/* progress + topbar */
const prog=$('#prog'),tb=$('#topbar');
addEventListener('scroll',()=>{
  const h=document.documentElement,max=h.scrollHeight-h.clientHeight;
  prog.style.width=(max>0?scrollY/max*100:0)+'%';
  tb.classList.toggle('on',scrollY>40);
},{passive:true});

/* reveal */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:.12});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));


/* live economics + stats: the same API the app uses, so numbers always match */
(function(){
  var pc=function(x){return Math.round(Number(x||0)*100)+'%';};
  var fmt=function(n){n=Number(n||0);if(n>=1e9)return (n/1e9).toFixed(2)+'B';if(n>=1e6)return (n/1e6).toFixed(2)+'M';if(n>=1e3)return (n/1e3).toFixed(1)+'K';return Math.floor(n).toLocaleString();};
  function setE(k,v){document.querySelectorAll('[data-econ="'+k+'"]').forEach(function(el){el.textContent=v;});}
  fetch('/api/economics').then(function(r){return r.json();}).then(function(e){
    var tiers=(e.amount_tiers||[]).slice();
    setE('base_pct',pc(e.base_apr));
    if(tiers[0]){setE('tier0_at',fmt(tiers[0][0]));setE('tier0_pct',pc(tiers[0][1]));}
    if(tiers[1]){setE('tier1_at',fmt(tiers[1][0]));setE('tier1_pct',pc(tiers[1][1]));}
    if(tiers[2]){setE('tier2_at',fmt(tiers[2][0]));setE('tier2_pct',pc(tiers[2][1]));}
    setE('loyalty_pct',pc(e.loyalty_per_30d));setE('loyalty_cap_pct',pc(e.loyalty_cap));
    setE('ref_pct',pc(e.referral_per));setE('ref_cap_pct',pc(e.referral_cap));
    setE('burn_unit',fmt(e.burn_unit));setE('burn_per_pct',pc(e.burn_apr_per_unit));
    ['burn_cap_pct','burn_cap_pct2','burn_cap_pct3'].forEach(function(k){setE(k,pc(e.burn_cap_apr));});
    var maxTier=tiers.length?Math.max.apply(null,tiers.map(function(t){return Number(t[1]||0);})):0;
    var maxApr=Number(e.base_apr||0)*(1+maxTier+Number(e.loyalty_cap||0)+Number(e.referral_cap||0))+Number(e.burn_cap_apr||0);
    var pctRound=Math.round(maxApr*100);
    setE('max_apr_pct_t',pctRound);
    document.querySelectorAll('[data-econ-to="max_apr_pct"]').forEach(function(el){el.dataset.to=pctRound;el.textContent=pctRound+'%';});
  }).catch(function(){});
  fetch('/api/stats').then(function(r){return r.json();}).then(function(s){
    var map={staked:'total_staked',stakers:'stakers',total_burned:'total_burned',burners:'burners'};
    Object.keys(map).forEach(function(k){
      var v=s[map[k]];
      document.querySelectorAll('[data-stat="'+k+'"]').forEach(function(el){el.textContent=fmt(v);});
    });
  }).catch(function(){});
})();

/* count-ups */
function cu(el){if(el._d)return;el._d=1;const to=+el.dataset.to,dec=+(el.dataset.dec||0),suf=el.dataset.suffix||'',t0=performance.now();
  (function f(t){const k=Math.min(1,(t-t0)/1100),e=1-Math.pow(1-k,3);
    el.textContent=(to*e).toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec})+suf;if(k<1)requestAnimationFrame(f);})(t0);}
const cio=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){cu(e.target);cio.unobserve(e.target);}}),{threshold:.5});
document.querySelectorAll('[data-to]').forEach(el=>cio.observe(el));

/* scroll-spy TOC */
const links=[...document.querySelectorAll('.toc a')];
const secs=links.map(a=>document.querySelector(a.getAttribute('href')));
const spy=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){
  const i=secs.indexOf(e.target);links.forEach(l=>l.classList.remove('on'));if(links[i])links[i].classList.add('on');
}})},{rootMargin:'-45% 0px -50% 0px'});
secs.forEach(s=>s&&spy.observe(s));
</script>

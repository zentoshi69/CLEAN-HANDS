# ===========================================================================
# CLEAN HANDS — environment template.   cp .env.example .env  &&  chmod 600 .env
# Fill the REQUIRED block; the rest have sane defaults (shown) and are optional.
# Never commit the real .env (see .gitignore). Rotate any leaked token via
# @BotFather /revoke, then `systemctl restart` the affected unit.
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Telegram bot tokens (one per bot, from @BotFather)
# ---------------------------------------------------------------------------
TG_BOT_TOKEN=                 # guardian_bot.py            (join CAPTCHA / anti-scam)
TG_SCANNER_TOKEN=             # solana_scanner_bot.py      (falls back to TG_BOT_TOKEN)
TG_COMMUNITY_TOKEN=           # community_bot.py + alerts + Mini App initData HMAC
TG_ADMIN_IDS=                 # comma-separated numeric user ids, e.g. 11111111,22222222

# ---------------------------------------------------------------------------
# REQUIRED — token + chain
# ---------------------------------------------------------------------------
DEFAULT_TOKEN_MINT=           # the $CLEAN mint — your pump.fun CA (see README)
DEFAULT_TOKEN_DECIMALS=6
SOLANA_RPC_URL=               # a PAID RPC (Helius/Triton) in prod; public RPC rate-limits
# DEFAULT_TOKEN_PAIR=         # optional: exact DexScreener pair address

# ---------------------------------------------------------------------------
# REQUIRED in prod — staking API (FastAPI, source of truth for site + Mini App)
# ---------------------------------------------------------------------------
STAKE_ENV=dev                 # set to 'prod' to fail-fast on missing secrets/mint
STAKE_SERVER_SECRET=          # REQUIRED in prod:  openssl rand -hex 32
STAKE_ADMIN_TOKEN=            # gates /api/admin/* payout endpoints: openssl rand -hex 32
STAKE_CORS_ORIGINS=           # your website origin(s): https://cleanhands.fun,https://www.cleanhands.fun
# STAKE_PORT=8090
# STAKE_DB=                   # default: a SQLite file inside staking-api/
# STAKE_SESSION_TTL=3600      # session token lifetime (seconds)
# STAKE_INITDATA_TTL=86400    # max age of Telegram initData (seconds)
# STAKE_BALANCE_TTL=300       # on-chain balance cache (seconds)
# STAKE_MAX_BODY=16384        # request body cap (bytes) -> 413 over limit
# Economics overrides (defaults live in staking-api/economics.py):
# STAKE_BASE_APR=0.40
# STAKE_BURN_APR_PER_UNIT=0.05
# Wallet-balance booster — extra multiplier for HOLDING value (non-custodial;
# SOL mandatory, CLEAN optional). SOL/USD is derived from the DexScreener pair.
# STAKE_BAL_BOOST=1           # 0 to disable the booster entirely
# STAKE_BAL_MIN_USD=50        # need >= this worth of SOL to qualify (the floor)
# STAKE_BAL_MAX_USD=500       # qualifying USD capped here (the ceiling)
# STAKE_BAL_BOOST_MIN=0.10    # +multiplier at the floor
# STAKE_BAL_BOOST_MAX=0.50    # +multiplier at the cap
# Booster price-trust guards (anti-manipulation): only trust a DexScreener price
# from a pool with real liquidity, and clamp SOL/USD to a plausible band so a
# thin/skewed $CLEAN pool can't inflate the booster. SOL/USD is sourced from an
# independent deep wSOL pool, not your own token's pool.
# STAKE_PRICE_MIN_LIQ_USD=2000  # ignore pools thinner than this for pricing
# STAKE_SOL_USD_MIN=10          # reject SOL/USD below this
# STAKE_SOL_USD_MAX=100000      # reject SOL/USD above this

# ---------------------------------------------------------------------------
# REQUIRED — Mini App wiring (referral links + in-app swap/burn)
# ---------------------------------------------------------------------------
MINIAPP_URL=                  # https://app.cleanhands.fun/  (community bot /app button + /newapp)
MINIAPP_BOT_USERNAME=         # your bot's @username, WITHOUT the @
MINIAPP_SHORT_NAME=app        # the /newapp short name
MINIAPP_SWAP_RPC=             # a BROWSER-safe RPC for the in-app Jupiter swap (NOT the paid one)
MINIAPP_INAPP_BURN=           # 1/true to enable in-app burn (irreversible — only after on-device QA)
MINIAPP_BRIDGE_URL=           # FALLBACK (link mode) No Stains Bridge URL, used ONLY when EASYBIT_API_KEY
                              #   is unset. Opens externally as a branded launch card.
MINIAPP_BRIDGE_EMBED=         # 1/true ONLY if MINIAPP_BRIDGE_URL is a real embeddable widget URL
                              #   (one that allows iframing) — then it renders inline instead.

# ---------------------------------------------------------------------------
# NO STAINS BRIDGE — white-label EasyBit (in-app swap). Set EASYBIT_API_KEY to
# turn the bridge tab into the real in-app swap form (bridgeMode="api"); leave
# it unset to keep the link-mode launch card above. The key stays server-side —
# the browser only ever calls /api/bridge/*.
# ---------------------------------------------------------------------------
EASYBIT_API_KEY=              # your EasyBit API key (request it from EasyBit). Enables API mode.
EASYBIT_API_BASE=             # default https://api.easybit.com (override only if told to)
EASYBIT_API_KEY_HEADER=       # default API-KEY (the header EasyBit expects the key in)
# Optional path overrides if the live API differs from the defaults:
#   EASYBIT_PATH_CURRENCY (/currencyList)  EASYBIT_PATH_PAIRINFO (/pairInfo)
#   EASYBIT_PATH_RATE (/rate)  EASYBIT_PATH_ORDER (/order)
#   EASYBIT_PATH_ORDERSTATUS (/orderStatus)  EASYBIT_PATH_VALIDATE (/validateAddress)
#   EASYBIT_EXTRA_FEE_PARAM (extraFeeOverride)
BRIDGE_FEE_USD=5              # flat service fee per order, in USD
BRIDGE_MIN_ORDER_USD=55       # minimum order, in USD
BRIDGE_EXTRA_FEE_MAX_PCT=10   # clamp on the per-order partner fee % (keep >= FEE/MIN*100, i.e. >=9.1)
BRIDGE_EXTRA_FEE_MIN_PCT=0    # floor on the per-order partner fee %
BRIDGE_REQUIRE_USD=1          # 1/true: block orders we can't price in USD (enforces the $ minimum)
BRIDGE_RESERVE_WALLET=        # your corporate reserve wallet (recorded for display/reconciliation).
                              #   The fee is actually paid out by EasyBit to the affiliate payout
                              #   address you configure in your EasyBit dashboard — set that to this.
BRIDGE_BRAND=No Stains Bridge # the visible brand name for the bridge UI

# ---------------------------------------------------------------------------
# OPTIONAL — scaling (multi-worker / multi-host)
# ---------------------------------------------------------------------------
# REDIS_URL=                  # shared login-nonce + rate-limit store across workers
# DATABASE_URL=               # Postgres DSN (postgresql://...); blank = SQLite
# RL_DISABLE=                 # set 1 to disable rate limiting (dev only)

# ---------------------------------------------------------------------------
# OPTIONAL but STRONGLY RECOMMENDED — off-box DB backup (the ledger is the money)
# ---------------------------------------------------------------------------
# The degen-backup.timer snapshots the SQLite DB daily. Set a remote to also push
# each snapshot OFF the box (a VPS loss otherwise loses who's owed payouts):
#   apt install rclone && rclone config        # create a remote, e.g. 'b2' (Backblaze/S3)
# BACKUP_RCLONE_REMOTE=        # e.g. b2:your-bucket/clean  (blank = LOCAL snapshots only)
# KEEP=14                      # local snapshots to retain (newest N)
# A reconcile/backup failure DMs TG_ALERTS_CHAT (or TG_ADMIN_IDS) via ops_alert.py.

# ---------------------------------------------------------------------------
# OPTIONAL — alerts / GM channel bot (alerts_bot.py, clean-gm.py)
# ---------------------------------------------------------------------------
# TG_ALERTS_TOKEN=            # falls back to TG_COMMUNITY_TOKEN
# TG_ALERTS_CHAT=             # @yourchannel  or  -100xxxxxxxxxx
# ALERTS_POLL=120             # market poll interval (seconds)
# ALERTS_PRICE_PCT=15         # alert when price moves this %
# ALERTS_HEARTBEAT_HRS=6

# ---------------------------------------------------------------------------
# OPTIONAL — staking notifier (staking-api/notifier.py)
# ---------------------------------------------------------------------------
# TG_NOTIFY_TOKEN=
# OWNER_CHAT=                 # chat id to receive ops notifications
# NOTIFY_POLL=900
# NOTIFY_COOLDOWN=86400
# NOTIFY_CLAIM_MIN=1000

# ---------------------------------------------------------------------------
# OPTIONAL — points-demo Mini App (miniapp/server.py)  [NOT the staking app]
# Off-chain "CLEAN points" demo. The production Mini App is staking-api/webapp.
# ---------------------------------------------------------------------------
# MINIAPP_PORT=8080
# MINIAPP_DB=
# MINIAPP_DAILY_CLAIM=100
# MINIAPP_WELCOME_BONUS=200
# MINIAPP_CLAIM_COOLDOWN=86400
# MINIAPP_REF_REFERRER=500
# MINIAPP_REF_REFEREE=250
# MINIAPP_INITDATA_TTL=86400

# ---------------------------------------------------------------------------
# OPTIONAL — misc
# ---------------------------------------------------------------------------
# CLEAN_API=https://app.cleanhands.fun   # base URL some helper scripts call
# MARKET_TTL=60                          # market data cache (seconds)
# MEME_FONT_PATH=                        # path to an Impact/Anton .ttf for /meme

# ---------------------------------------------------------------------------
# OPTIONAL — season campaign (the Boost tab's community goal card)
# ---------------------------------------------------------------------------
# STAKE_TOTAL_SUPPLY=1000000000          # total token supply (pump.fun = 1B)
# SEASON_END_TS=                         # unix ts:  date -d '+60 days' +%s
# SEASON_BURN_GOAL_PCT=5                 # community goal: burn this % of supply
# SEASON_NAME=Season 1 — The Big Wash

# Claims vest: claimable only after N days of continuous staking; unstaking
# forfeits pending rewards and resets the clock. 0 disables the lock.
# STAKE_CLAIM_LOCK_DAYS=90
# STAKE_CLAIM_FEE_USD=5                  # claim processing fee, deducted in $CLEAN
# STAKE_PAYOUT_SETUP_DAYS=3              # payout-wallet setup opens N days pre-unlock

# ---------------------------------------------------------------------------
# OPTIONAL — AI meme engine (/meme replaces hands with the $CLEAN glove)
# Engine: Gemini 2.5 Flash Image ("Nano Banana") — ~$0.039/image, fast.
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=                        # no key = local glove-stamp fallback
# MEME_AI_MODEL=gemini-2.5-flash-image
# MEME_AI_COOLDOWN=60                    # seconds between AI memes per user
# MEME_AI_TIMEOUT=60                     # hard cap (s) for one wash; falls back after
# MEME_AI_CONNECT_TIMEOUT=10             # connect cap (s); a blocked egress fails fast
# GEMINI_API_BASE=                       # override API base (e.g. a proxy); optional

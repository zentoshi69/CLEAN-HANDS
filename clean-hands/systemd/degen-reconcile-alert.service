[Unit]
Description=Alert admins when CLEAN reconciliation detects money drift

[Service]
Type=oneshot
WorkingDirectory=/home/youruser/bots/staking-api
EnvironmentFile=/home/youruser/bots/.env
ExecStart=/home/youruser/bots/staking-api/venv/bin/python ops_alert.py "❌ degen-reconcile FAILED on %H — money-invariant drift detected. Inspect now: journalctl -u degen-reconcile -n 50"
User=youruser

# --- Hardening (read-only; net for the Telegram send) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/youruser/bots/staking-api
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6

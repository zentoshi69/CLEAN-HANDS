# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Image edit provider: mock | generic_http | future
IMAGE_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_ENDPOINT=
# Optional fixed seed: same image + prompt reproduces the same gloves.
# Leave blank for the provider's default (random) behaviour.
IMAGE_PROVIDER_SEED=

# Comma-separated Telegram user IDs allowed to use /debug
ADMIN_TELEGRAM_IDS=

# Limits
MAX_IMAGE_SIZE_MB=15
OUTPUT_MAX_SIDE=1536
DELETE_FILES_AFTER_HOURS=24

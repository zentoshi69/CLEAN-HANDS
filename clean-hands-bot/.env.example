# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Image edit provider: flux_fill | generic_http | mock | future
#   flux_fill    → FLUX.1 Fill [pro] mask inpainting (Black Forest Labs). BEST
#                  glove quality. Set IMAGE_PROVIDER_API_KEY to your BFL key.
#   generic_http → any custom inpainting endpoint (multipart image+mask)
#   mock         → offline flat blue tint, NOT real gloves (dev/demo only)
IMAGE_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=
# Optional: override the provider endpoint. flux_fill defaults to
# https://api.bfl.ai/v1/flux-pro-1.0-fill when left blank.
IMAGE_PROVIDER_ENDPOINT=
# Optional fixed seed: same image + prompt reproduces the same gloves.
# Leave blank for the provider's default (random) behaviour.
IMAGE_PROVIDER_SEED=

# Hand detection tuning. Tighter values = fewer phantom "invented" hands.
HAND_MAX_NUM_HANDS=4
HAND_MIN_DETECTION_CONFIDENCE=0.6

# Comma-separated Telegram user IDs allowed to use /debug
ADMIN_TELEGRAM_IDS=

# Limits
MAX_IMAGE_SIZE_MB=15
OUTPUT_MAX_SIDE=1536
DELETE_FILES_AFTER_HOURS=24
